@page
@model RegisterModel
@{
    ViewData["Title"] = "Register New User";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    html, body, main, .container, .pb-3, header, footer {
        background-color: #000000 !important;
        color: white;
    }

    .register-box {
        max-width: 500px;
        margin: 60px auto;
        background-color: #0d0d0d;
        border: 1px solid #1a1a1a;
        border-radius: 15px;
        padding: 45px;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.8);
    }

    .gt-brand {
        font-size: 2.6rem;
        font-weight: 900;
        text-align: center;
        display: block;
        margin-bottom: 5px;
        letter-spacing: -1px;
    }

    .accent-blue {
        color: #00d4ff;
    }

    .gt-status {
        color: #666;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 5px;
        text-align: center;
        display: block;
        margin-bottom: 30px;
    }

    .form-control-gt {
        background-color: #ffffff !important;
        color: #000000 !important;
        border: 2px solid #222;
        padding: 12px 15px;
        border-radius: 8px;
        font-weight: 600;
        transition: 0.3s;
    }

        .form-control-gt:focus {
            border-color: #28a745;
            box-shadow: 0 0 15px rgba(40, 167, 69, 0.3);
            outline: none;
        }

    .form-label-gt {
        color: #888;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 800;
        margin-bottom: 6px;
        letter-spacing: 1px;
    }

    .btn-gt-submit {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 16px;
        font-weight: 900;
        text-transform: uppercase;
        width: 100%;
        border-radius: 8px;
        margin-top: 10px;
        transition: 0.3s;
        font-size: 1.2rem;
    }

        .btn-gt-submit:hover {
            background-color: #218838;
            box-shadow: 0 0 25px rgba(40, 167, 69, 0.5);
            transform: translateY(-2px);
        }

    .gt-link {
        color: #00d4ff;
        text-decoration: none;
        font-weight: 600;
    }
</style>

<div class="register-box">
    <span class="gt-brand">GT<span class="accent-blue">AUTO</span></span>
    <span class="gt-status">Create New Identity</span>

    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div asp-validation-summary="All" class="text-danger small fw-bold mb-3"></div>

        <div class="mb-3">
            <label asp-for="Input.FullName" class="form-label-gt">Full Name</label>
            <input asp-for="Input.FullName" class="form-control form-control-gt" placeholder="Enter your full name" />
            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label-gt">User Email</label>
            <input asp-for="Input.Email" class="form-control form-control-gt" autocomplete="username" placeholder="Enter your email" />
        </div>

        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label-gt">Create Password</label>
            <input asp-for="Input.Password" class="form-control form-control-gt" autocomplete="new-password" placeholder="••••••••" />
        </div>

        <div class="mb-4">
            <label asp-for="Input.ConfirmPassword" class="form-label-gt">Confirm Password</label>
            <input asp-for="Input.ConfirmPassword" class="form-control form-control-gt" autocomplete="new-password" placeholder="••••••••" />
        </div>

        <button id="registerSubmit" type="submit" class="btn-gt-submit">
            <i class="bi bi-person-plus-fill me-2"></i> Register Account
        </button>

        <div class="text-center mt-4 pt-3 border-top border-secondary">
            <p class="mb-0 text-muted small">
                Already have an identity? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="gt-link">Login here</a>
            </p>
        </div>
    </form>
</div>