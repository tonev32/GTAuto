@page
@model LoginModel

@{
    ViewData["Title"] = "Secure Access";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    html, body, main, .container, .pb-3, header, footer {
        background-color: #000000 !important;
        background: #000000 !important;
        color: white;
    }
    .border-top, header, footer {
        border-color: #111 !important;
    }

    .login-box {
        max-width: 450px;
        margin: 80px auto;
        background-color: #0d0d0d;
        border: 1px solid #1a1a1a;
        border-radius: 15px;
        padding: 45px;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.8);
    }

    .gt-brand {
        font-size: 2.6rem;
        font-weight: 900;
        text-align: center;
        display: block;
        margin-bottom: 5px;
        letter-spacing: -1px;
    }

    .accent-blue { color: #00d4ff; }

    .gt-status {
        color: #666;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 5px;
        text-align: center;
        display: block;
        margin-bottom: 40px;
    }

    /* БЕЛИТЕ ПОЛЕТА (ЗАПАЗЕНИ ПО ТВОЕ ЖЕЛАНИЕ) */
    .form-control-gt {
        background-color: #ffffff !important;
        color: #000000 !important;
        border: 2px solid #222;
        padding: 14px 15px;
        border-radius: 8px;
        font-weight: 600;
        transition: 0.3s;
        height: auto;
    }

    .form-control-gt:focus {
        border-color: #28a745; /* Светва в зелено при фокус */
        box-shadow: 0 0 15px rgba(40, 167, 69, 0.3);
        outline: none;
    }

    .form-label-gt {
        color: #888;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 800;
        margin-bottom: 8px;
        letter-spacing: 1px;
    }

    /* ЗЕЛЕНИЯТ БУТОН */
    .btn-gt-submit {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 16px;
        font-weight: 900;
        text-transform: uppercase;
        width: 100%;
        border-radius: 8px;
        margin-top: 10px;
        transition: 0.3s;
        font-size: 1.2rem;
        letter-spacing: 1px;
    }

    .btn-gt-submit:hover {
        background-color: #218838;
        box-shadow: 0 0 25px rgba(40, 167, 69, 0.5);
        transform: translateY(-2px);
    }

    .gt-footer-links {
        margin-top: 30px;
        text-align: center;
        border-top: 1px solid #1a1a1a;
        padding-top: 20px;
    }

    .gt-link {
        color: #00d4ff;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 600;
        transition: 0.2s;
    }

    .gt-link:hover {
        color: white;
        text-decoration: underline;
    }

    .form-floating > label {
        display: none;
    }
</style>

<div class="login-box">
    <span class="gt-brand">GT<span class="accent-blue">AUTO</span></span>
    <span class="gt-status">Identity Verification</span>

    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label-gt">Access Email</label>
            <input asp-for="Input.Email" class="form-control form-control-gt" autocomplete="username" aria-required="true" placeholder="Enter your email" />
            <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Input.Password" class="form-label-gt">Access Password</label>
            <input asp-for="Input.Password" class="form-control form-control-gt" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
            <span asp-validation-for="Input.Password" class="text-danger small"></span>
        </div>

        <div class="form-check mb-4">
            <input class="form-check-input" asp-for="Input.RememberMe" style="cursor: pointer;" />
            <label class="form-check-label text-muted small" asp-for="Input.RememberMe" style="cursor: pointer;">
                Stay authorized on this device
            </label>
        </div>

        <button id="login-submit" type="submit" class="btn-gt-submit">
            <i class="bi bi-unlock-fill me-2"></i> Log In
        </button>

        <div class="gt-footer-links">
            <p class="mb-2">
                <a id="forgot-password" asp-page="./ForgotPassword" class="gt-link">Lost your credentials?</a>
            </p>
            <p class="mb-2">
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="gt-link">New user? Register here</a>
            </p>
            <p class="mb-0">
                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="gt-link">Resend confirmation</a>
            </p>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}