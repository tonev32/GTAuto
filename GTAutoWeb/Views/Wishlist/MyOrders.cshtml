@model IEnumerable<GTAuto.Data.Models.Car>

@{
    ViewData["Title"] = "Active Orders";
}

<style>
    /* ГЛАВЕН КОНТЕЙНЕР - NOIR THEME */
    body, main, .container-fluid, .pb-3 {
        background-color: #000000 !important;
        color: white;
    }

    .order-wrapper {
        padding: 60px 0;
        min-height: 85vh;
    }

    .order-title {
        font-size: 3.5rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: -1px;
        margin-bottom: 10px;
    }

    .accent-cyan {
        color: #00e5ff;
        text-shadow: 0 0 20px rgba(0, 229, 255, 0.4);
    }

    /* КАРТИ ЗА ПОРЪЧКИ */
    .order-card-noir {
        background: #090909;
        border: 1px solid #1a1a1a;
        border-radius: 12px;
        overflow: hidden;
        transition: 0.4s;
        margin-bottom: 20px;
    }

    .order-card-noir:hover {
        border-color: #00e5ff;
        box-shadow: 0 0 30px rgba(0, 229, 255, 0.1);
    }

    /* СЕКЦИЯ ЗА ОТМЯНА */
    .cancel-warning-box {
        background-color: rgba(255, 51, 51, 0.05);
        border: 1px dashed #ff3333;
        color: #ff3333;
        padding: 15px;
        border-radius: 8px;
        margin-top: 15px;
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1px;
    }

    .phone-highlight {
        display: block;
        font-size: 1.2rem;
        color: #ffffff;
        margin-top: 5px;
        text-shadow: 0 0 10px rgba(255, 255, 255, 0.2);
    }

    .status-badge {
        background-color: #00e5ff;
        color: #000;
        font-weight: 900;
        font-size: 0.7rem;
        padding: 5px 12px;
        border-radius: 4px;
        text-transform: uppercase;
        display: inline-block;
        margin-bottom: 10px;
    }

    .empty-state i {
        font-size: 5rem;
        color: #1a1a1a;
        margin-bottom: 20px;
    }
</style>

<div class="order-wrapper">
    <div class="container">
        @* HEADER *@
        <div class="text-center mb-5">
            <h1 class="order-title">Active <span class="accent-cyan">Orders</span></h1>
            <p class="text-muted text-uppercase small" style="letter-spacing: 3px;">Track your officially secured premium assets</p>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5 empty-state">
                <i class="bi bi-box-seam"></i>
                <h2 class="text-secondary fw-bold">NO ACTIVE ORDERS</h2>
                <p class="text-muted">You haven't reserved any vehicles yet. Once you secure an asset, it will appear here.</p>
                <a asp-controller="Cars" asp-action="Index" class="btn btn-outline-info mt-3 px-5 fw-bold py-2" style="border-width: 2px;">
                    EXPLORE INVENTORY
                </a>
            </div>
        }
        else
        {
            <div class="row justify-content-center">
                @foreach (var car in Model)
                {
                    var mainImg = car.Images?.OrderBy(i => i.Order).FirstOrDefault()?.ImagePath ?? "/images/no-image.png";

                    <div class="col-lg-10">
                        <div class="card order-card-noir p-3">
                            <div class="row align-items-center">
                                @* СНИМКА НА КОЛАТА *@
                                <div class="col-md-4">
                                    <div class="position-relative">
                                        <img src="@mainImg" class="img-fluid rounded" alt="@car.Model.Name" style="width: 100%; height: 200px; object-fit: cover;">
                                    </div>
                                </div>

                                @* ДЕТАЙЛИ ЗА КОЛАТА *@
                                <div class="col-md-4">
                                    <div class="ps-md-3 mt-3 mt-md-0">
                                        <span class="status-badge">Payment Confirmed</span>
                                        <h3 class="text-white fw-bold mb-1">@car.Model.Name</h3>
                                        <p class="text-muted mb-3">Year: @car.Year | Fuel: @car.FuelType | HP: @car.HorsePower</p>
                                        <div style="color: #00e5ff; font-weight: 900; font-size: 1.8rem;">
                                            @car.Price.ToString("N0") €
                                        </div>
                                    </div>
                                </div>

                                @* СЕКЦИЯ ЗА ОТМЯНА (ПО ТЕЛЕФОН) *@
                                <div class="col-md-4">
                                    <div class="cancel-warning-box text-center">
                                        <i class="bi bi-exclamation-octagon-fill d-block mb-2 fs-4"></i>
                                        To cancel this order, you must contact us directly:
                                        <span class="phone-highlight">
                                            <i class="bi bi-telephone-fill me-1"></i> +359 888 GT AUTO
                                        </span>
                                    </div>
                                    <div class="mt-3">
                                        <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id" class="btn btn-sm btn-outline-secondary w-100 fw-bold">
                                            VIEW FULL SPECIFICATIONS
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* ДОПЪЛНИТЕЛНА ИНФОРМАЦИЯ НАЙ-ОТДОЛУ *@
            <div class="text-center mt-5">
                <p class="text-secondary small">
                    All reservations are legally binding. Our logistics team will contact you shortly for delivery arrangements.
                </p>
            </div>
        }
    </div>
</div>