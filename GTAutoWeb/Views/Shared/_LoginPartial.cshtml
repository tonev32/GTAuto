@using Microsoft.AspNetCore.Identity
@using GTAuto.Data.Models
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<ul class="navbar-nav align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var displayName = !string.IsNullOrEmpty(user?.FullName) ? user.FullName : User.Identity?.Name;

        <li class="nav-item">
            <a class="nav-link text-white fw-bold me-3" style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; cursor: default;">
                Hello, <span style="color: #00d4ff !important;">@displayName!</span>
            </a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-white fw-bold" style="text-transform: uppercase; font-size: 0.85rem; padding: 0; border: none; vertical-align: baseline;">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white fw-bold text-uppercase" style="font-size: 0.8rem;" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white fw-bold text-uppercase" style="font-size: 0.8rem;" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>