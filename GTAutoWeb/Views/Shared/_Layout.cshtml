<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GTAuto</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --bg-black: #000000;
            --bg-dark-gray: #0a0a0a;
            --accent-blue: #00d4ff;
            --accent-red: #ff3333;
            --text-white: #ffffff;
        }

        body {
            background-color: var(--bg-black) !important;
            color: var(--text-white);
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            min-height: 100vh; /* Гарантира, че футърът винаги ще е долу */
        }

        .navbar {
            background-color: var(--bg-dark-gray) !important;
            border-bottom: 1px solid rgba(0, 212, 255, 0.2);
            padding: 15px 0;
            position: relative;
            z-index: 10000 !important;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.7rem;
            color: #fff !important;
        }

            .navbar-brand span {
                color: var(--accent-blue);
                text-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
            }

        /* 🔵 СТАНДАРТНИ ЛИНКОВЕ */
        .nav-link {
            color: var(--text-white) !important;
            text-transform: uppercase;
            font-weight: 700;
            margin: 0 5px;
            font-size: 0.8rem;
            transition: 0.3s;
            letter-spacing: 1px;
        }

            .nav-link:hover {
                color: var(--accent-blue) !important;
                text-shadow: 0 0 8px var(--accent-blue) !important;
            }

        /* 🔴 АДМИН ЛИНК ЗА РЕЗЕРВАЦИИ */
        a.nav-link.nav-link-danger {
            color: var(--accent-red) !important;
        }

            a.nav-link.nav-link-danger:hover {
                color: #ff0000 !important;
                text-shadow: 0 0 12px #ff0000 !important;
            }

        /* Настройка за мобилното меню */
        .navbar-toggler {
            border-color: rgba(0, 212, 255, 0.5) !important;
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%280, 212, 255, 1%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e") !important;
        }

        main {
            flex: 1; /* Кара main секцията да заема оставащото пространство */
        }

        footer {
            background-color: var(--bg-dark-gray);
            border-top: 1px solid #1a1a1a;
            padding: 25px 0;
            width: 100%;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    GT<span>AUTO</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-center">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About Us</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Cars" asp-action="Index">Inventory</a></li>
                        @if (User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                        {
                            <li class="nav-item ms-3">
                                <a class="nav-link fw-bold text-uppercase" asp-controller="Wishlist" asp-action="Index" style="letter-spacing: 1px; transition: 0.3s;" onmouseover="this.style.color='#00e5ff'" onmouseout="this.style.color=''">
                                    MY GARAGE
                                </a>
                            </li>
                        }

                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cars" asp-action="Create">Create Listing</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Models" asp-action="Index">Listing Data</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-danger" asp-controller="Cars" asp-action="ReservedCars">
                                    <i class="bi bi-shield-lock-fill me-1"></i> RESERVED ASSETS
                                </a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="text-center mt-auto">
        <div class="container">
            <p class="text-muted small mb-0 fw-bold">&copy; 2026 - GTAuto Prestige - Power in Blue</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>