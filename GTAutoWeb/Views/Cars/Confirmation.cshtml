@model GTAuto.Data.Models.Reservation
@{
    ViewData["Title"] = "Reservation Successful";
}

<style>
    /* 🔥 GTAUTO NOIR CONFIRMATION STYLE 🔥 */
    /* ПЪЛНО ПРЕМАХВАНЕ НА СИВОТО ПОЛЕ ГОРЕ И ДОЛУ */
    html, body, main, header, nav, .navbar, footer, .container, .pb-3 {
        background-color: #000000 !important;
        background: #000000 !important;
        border: none !important;
        box-shadow: none !important;
    }

    /* Махаме всякакви линии под навигацията */
    header, .navbar {
        border-bottom: none !important;
    }

    .success-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 0;
    }

    .success-card {
        max-width: 650px;
        width: 100%;
        text-align: center;
    }

    .check-icon-glow {
        font-size: 6rem;
        color: #28a745;
        filter: drop-shadow(0 0 20px rgba(40, 167, 69, 0.4));
        margin-bottom: 25px;
    }

    .main-title {
        color: white;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 2.5rem;
        margin-bottom: 10px;
    }

    .accent-blue {
        color: #00d4ff;
        text-shadow: 0 0 10px rgba(0, 212, 255, 0.4);
    }

    .sub-title {
        color: #888;
        font-size: 1.2rem;
        margin-bottom: 40px;
    }

    .info-box-noir {
        background-color: #0d0d0d;
        border: 1px solid #1a1a1a;
        border-radius: 12px;
        padding: 35px;
        text-align: left;
        position: relative;
        overflow: hidden;
    }

        .info-box-noir::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: #00d4ff;
        }

    .info-header {
        color: #00d4ff;
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.9rem;
        letter-spacing: 1.5px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
    }

    .info-text {
        color: #bbb;
        line-height: 1.7;
        font-size: 1rem;
        margin-bottom: 0;
    }

    .highlight-white {
        color: white;
        font-weight: bold;
    }

    /* БУТОНИ */
    .btn-group-custom {
        display: flex;
        gap: 20px;
        justify-content: center;
        margin-top: 50px;
    }

    .btn-orders {
        background-color: #00d4ff;
        color: #000;
        padding: 15px 35px;
        font-weight: 800;
        text-transform: uppercase;
        border-radius: 4px;
        transition: 0.3s;
        text-decoration: none;
        letter-spacing: 1px;
        border: 2px solid #00d4ff;
    }

        .btn-orders:hover {
            background-color: transparent;
            color: #00d4ff !important;
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
        }

    .btn-outline-home {
        background-color: transparent;
        color: #ffffff;
        border: 2px solid #333;
        padding: 15px 35px;
        font-weight: 800;
        text-transform: uppercase;
        border-radius: 4px;
        transition: 0.3s;
        text-decoration: none;
    }

        .btn-outline-home:hover {
            border-color: #fff;
            background-color: #fff;
            color: #000 !important;
        }
</style>

<div class="success-wrapper">
    <div class="success-card">
        <i class="bi bi-check-all check-icon-glow"></i>

        <h1 class="main-title">CONGRATS! <br /> <span class="accent-blue">ASSET SECURED</span></h1>
        <p class="sub-title">Your <span class="highlight-white">@Model.Car.Model.Name</span> has been successfully reserved.</p>

        <div class="info-box-noir shadow-lg">
            <div class="info-header">
                <i class="bi bi-shield-check me-2 fs-5"></i> Official Notice
            </div>
            <p class="info-text">
                The asset is now under <span class="highlight-white">temporary reservation</span>.
                You have a period of <span class="highlight-white text-decoration-underline">30 days</span> (until @Model.ExpiryDate.ToString("dd.MM.yyyy"))
                to visit the <span class="accent-blue fw-bold">GTAuto Showroom</span> and finalize the remaining balance to complete the acquisition.
            </p>
        </div>

        <div class="btn-group-custom">
            @* БУТОН КЪМ ПОРЪЧКИТЕ *@
            <a asp-controller="Wishlist" asp-action="MyOrders" class="btn-orders shadow">
                <i class="bi bi-box-seam me-2"></i> View My Orders
            </a>

            @* БУТОН КЪМ НАЧАЛО *@
            <a asp-controller="Home" asp-action="Index" class="btn-outline-home">
                <i class="bi bi-house-door me-2"></i> Showroom
            </a>
        </div>
    </div>
</div>