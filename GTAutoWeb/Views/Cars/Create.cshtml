@model GTAutoWeb.ViewModel.CarViewModel

@{
    ViewData["Title"] = "Create Car Ad";
}

<style>
    /* Дизайн на фона и контейнера */
    .create-wrapper {
        background-color: #000000 !important;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 0;
    }

    .create-card {
        background-color: #0d0d0d;
        border: 1px solid #1a1a1a;
        border-radius: 15px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.8);
        width: 100%;
        max-width: 900px;
    }

    /* Стилизиране на полетата за писане */
    .form-control, .form-select {
        background-color: #000000 !important;
        border: 1px solid #333 !important;
        color: white !important;
        border-radius: 8px;
        padding: 12px 15px;
        transition: 0.3s;
    }

        .form-control:focus, .form-select:focus {
            border-color: #00d4ff !important;
            box-shadow: 0 0 10px rgba(0, 212, 255, 0.2) !important;
        }

    /* Етикети (Labels) */
    .form-label {
        color: #00d4ff;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1.5px;
        font-weight: 800;
        margin-bottom: 8px;
        display: block;
        text-align: left;
    }

    /* Бутонът */
    .btn-submit {
        background-color: #00d4ff;
        color: #000;
        border: none;
        padding: 14px 50px;
        font-weight: 800;
        text-transform: uppercase;
        border-radius: 4px;
        transition: 0.3s;
    }

        .btn-submit:hover {
            background-color: #00aacc;
            transform: translateY(-2px);
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.4);
        }

    /* Секция за снимки */
    .image-upload-section {
        background-color: #080808;
        border: 1px dashed #333;
        border-radius: 10px;
        padding: 20px;
        margin: 25px 0;
    }

    /* Персонализирани тъмни чекбоксове */
    .form-check-input {
        background-color: #1a1a1a;
        border: 1px solid #444;
    }

        .form-check-input:checked {
            background-color: #00d4ff;
            border-color: #00d4ff;
            box-shadow: 0 0 8px #00d4ff;
        }

    /* Файловите инпути да изглеждат добре на черно */
    input[type="file"]::-webkit-file-upload-button {
        background: #1a1a1a;
        color: #00d4ff;
        border: 1px solid #333;
        padding: 8px 16px;
        margin-right: 10px;
        border-radius: 4px;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 0.7rem;
        transition: 0.3s;
    }

        input[type="file"]::-webkit-file-upload-button:hover {
            background: #00d4ff;
            color: #000;
        }

    /* 🔥 Премахване на грозните стрелки от числовите полета 🔥 */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield;
    }
</style>

<div class="create-wrapper">
    <div class="create-card">
        <h2 class="text-white fw-bold mb-4 text-uppercase text-center" style="letter-spacing: 2px;">
            Create New <span style="color: #00d4ff;">Advertisement</span>
        </h2>
        <hr style="border-color: #1a1a1a; margin-bottom: 30px;" />

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-4 fw-bold bg-dark p-3 rounded" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

            <div class="row g-4 text-start">
                @* МОДЕЛ *@
                <div class="col-md-12">
                    <label class="form-label">Vehicle Model</label>
                    <select asp-for="ModelId" class="form-select" asp-items="ViewBag.Models">
                        <option value="">-- Select Brand and Model --</option>
                    </select>
                    <span asp-validation-for="ModelId" class="text-danger small"></span>
                </div>

                @* ОСНОВНИ ДАННИ (Ръчно писане с type="number") *@
                <div class="col-md-3">
                    <label asp-for="Year" class="form-label">Production Year</label>
                    <input asp-for="Year" type="number" class="form-control" placeholder="e.g. 2023" />
                    <span asp-validation-for="Year" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="HorsePower" class="form-label">HorsePower (HP)</label>
                    <input asp-for="HorsePower" type="number" class="form-control" placeholder="e.g. 500" />
                    <span asp-validation-for="HorsePower" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Price" class="form-label">Price (€)</label>
                    <input asp-for="Price" type="number" class="form-control" placeholder="e.g. 45000" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Mileage" class="form-label">Mileage (km)</label>
                    <input asp-for="Mileage" type="number" class="form-control" placeholder="e.g. 12000" />
                    <span asp-validation-for="Mileage" class="text-danger small"></span>
                </div>

                @* ТЕХНИЧЕСКИ ДАННИ (Падащи менюта) *@
                <div class="col-md-4">
                    <label asp-for="FuelType" class="form-label">Fuel Type</label>
                    <select asp-for="FuelType" class="form-select">
                        <option value="">-- Select Fuel --</option>
                        <option value="Gas">Gas</option>
                        <option value="Petrol">Petrol</option>
                        <option value="Diesel">Diesel</option>
                        <option value="Hybrid">Hybrid</option>
                        <option value="Electric">Electric</option>
                    </select>
                    <span asp-validation-for="FuelType" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Transmission" class="form-label">Transmission</label>
                    <select asp-for="Transmission" class="form-select">
                        <option value="">-- Select Gearbox --</option>
                        <option value="Automatic">Automatic</option>
                        <option value="Manual">Manual</option>
                        <option value="Semi-Automatic">Semi-Automatic</option>
                    </select>
                    <span asp-validation-for="Transmission" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Color" class="form-label">Color</label>
                    <input asp-for="Color" class="form-control" placeholder="e.g. Black" />
                    <span asp-validation-for="Color" class="text-danger small"></span>
                </div>

                @* 🔥 СЕКЦИЯ ЗА СНИМКИ 🔥 *@
                <div class="col-12">
                    <div class="image-upload-section">
                        <h5 class="text-white small fw-bold text-uppercase mb-4" style="letter-spacing: 1px;">Vehicle Photography (Local Upload)</h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label" style="color: #00d4ff;">1. Front View</label>
                                <input type="file" asp-for="FrontImage" class="form-control" accept="image/*" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" style="color: #00d4ff;">2. Rear View</label>
                                <input type="file" asp-for="BackImage" class="form-control" accept="image/*" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" style="color: #00d4ff;">3. Interior</label>
                                <input type="file" asp-for="InteriorImage" class="form-control" accept="image/*" />
                            </div>
                        </div>
                    </div>
                </div>

                @* ОПИСАНИЕ *@
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Technical Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter detailed description..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                @* ОПЦИИ (Само FLASH OFFER остана тук) *@
                <div class="col-12">
                    <div class="d-flex flex-wrap gap-4 mt-2 p-3" style="background-color: #111; border-radius: 8px; border: 1px solid #222;">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IsFlashOffer" id="flashOfferCheck">
                            <label class="form-check-label text-info fw-bold ms-2" for="flashOfferCheck">🔥 FLASH OFFER (SALE)</label>
                        </div>
                    </div>
                </div>
            </div>

            @* БУТОНИ *@
            <div class="text-center mt-5">
                <button type="submit" class="btn btn-submit w-100 fs-5"><i class="bi bi-cloud-arrow-up-fill me-2"></i> Create Listing</button>
                <div class="mt-4">
                    <a asp-action="Index" class="text-muted text-decoration-none small fw-bold text-uppercase" onmouseover="this.style.color='#00d4ff'" onmouseout="this.style.color='#666'">
                        <i class="bi bi-arrow-left me-1"></i> Cancel and Back to List
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}