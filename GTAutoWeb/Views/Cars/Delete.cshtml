@model GTAuto.Data.Models.Car

@{
    ViewData["Title"] = "Confirm Deletion";
}

<style>
    /* 🔥 СТОП НА ГРОЗНИЯ СИНЬО-СИВ ФОН 🔥 */
    html, body, main, header, nav, .navbar, footer, .container, .pb-3 {
        background-color: #000000 !important;
        background: #000000 !important;
        border: none !important;
        box-shadow: none !important;
    }

    /* Махаме всякакви линии под навигацията */
    header, .navbar {
        border-bottom: none !important;
    }

    .delete-wrapper {
        min-height: 100vh;
        padding: 60px 0;
        background-color: #000000;
    }

    .delete-card {
        background-color: #0d0d0d;
        border: 1px solid #dc3545; /* Червена рамка за предупреждение */
        border-radius: 15px;
        padding: 40px;
        box-shadow: 0 0 30px rgba(220, 53, 69, 0.2);
    }

    .spec-label {
        color: #8c8c8c;
        text-transform: uppercase;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .spec-value {
        color: #ffffff;
        font-weight: 600;
        border-bottom: 1px solid #1a1a1a;
        padding-bottom: 5px;
        margin-bottom: 15px;
    }

    .btn-delete-confirm {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 15px 40px;
        font-weight: 800;
        text-transform: uppercase;
        border-radius: 4px;
        transition: 0.3s;
        cursor: pointer;
    }

        .btn-delete-confirm:hover {
            background-color: #a71d2a;
            transform: scale(1.02);
            box-shadow: 0 0 20px rgba(220, 53, 69, 0.5);
        }

    .btn-cancel {
        color: #8c8c8c;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-cancel:hover {
            color: white;
        }
</style>

<div class="delete-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 delete-card text-center">
                <i class="bi bi-exclamation-triangle-fill text-danger mb-3" style="font-size: 3rem;"></i>
                <h1 class="fw-bold text-white text-uppercase mb-2">Confirm <span class="text-danger">Deletion</span></h1>
                <p class="text-muted mb-5">Are you sure you want to permanently remove this asset from the inventory?</p>

                <div class="row g-4 text-start">
                    <div class="col-md-5">
                        @{
                            var mainImg = Model.Images?.OrderBy(i => i.Order).FirstOrDefault()?.ImagePath ?? "/images/no-image.png";
                        }
                        <img src="@mainImg" class="img-fluid rounded shadow" style="width: 100%; height: 250px; object-fit: cover; border: 1px solid #333; background-color: #000;">
                        
                        <div class="mt-3 p-3 bg-black rounded border border-secondary">
                            <div class="spec-label">Current Status</div>
                            <div class="fw-bold @(Model.IsSold ? "text-danger" : "text-success")">
                                @(Model.IsSold ? "SOLD" : (Model.IsReserved ? "RESERVED" : "AVAILABLE"))
                            </div>
                        </div>
                    </div>

                    <div class="col-md-7">
                        <div class="row">
                            <div class="col-6">
                                <div class="spec-label">Model</div>
                                <div class="spec-value">@Model.Model.Name</div>
                            </div>
                            <div class="col-6">
                                <div class="spec-label">Price</div>
                                <div class="spec-value text-danger">@Model.Price.ToString("N0") €</div>
                            </div>
                            <div class="col-6">
                                <div class="spec-label">Year</div>
                                <div class="spec-value">@Model.Year</div>
                            </div>
                            <div class="col-6">
                                <div class="spec-label">Horsepower</div>
                                <div class="spec-value">@Model.HorsePower HP</div>
                            </div>
                            <div class="col-6">
                                <div class="spec-label">Fuel</div>
                                <div class="spec-value">@Model.FuelType</div>
                            </div>
                            <div class="col-6">
                                <div class="spec-label">Color</div>
                                <div class="spec-value">@Model.Color</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-4 border-top border-secondary d-flex align-items-center justify-content-center gap-4">
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn-delete-confirm">Delete Asset</button>
                    </form>
                    <a asp-action="Index" class="btn-cancel">Cancel and Go Back</a>
                </div>
            </div>
        </div>
    </div>
</div>