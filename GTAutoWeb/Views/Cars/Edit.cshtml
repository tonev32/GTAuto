@model GTAutoWeb.ViewModel.CarViewModel

@{
    ViewData["Title"] = "Edit Asset";
}

<style>
    /* 🔥 ФОРСИРАМЕ ЧИСТО ЧЕРНО НАВСЯКЪДЕ 🔥 */
    html, body, main, .container-fluid, .pb-3 {
        background-color: #000000 !important;
        color: white;
    }

    .edit-card {
        background-color: #090909; /* Много тъмно сиво, почти черно, без зелено */
        border: 1px solid #1a1a1a;
        border-radius: 15px;
        padding: 35px;
        margin-top: 30px;
        box-shadow: 0 10px 30px rgba(0, 229, 255, 0.08); /* Лек cyan glow */
    }

    .form-control, .form-select {
        background-color: #000000 !important;
        border: 1px solid #222 !important;
        color: white !important;
        border-radius: 8px;
        padding: 10px 15px;
    }

        .form-control:focus, .form-select:focus {
            border-color: #00e5ff !important; /* GTAuto Cyan */
            box-shadow: 0 0 10px rgba(0, 229, 255, 0.2) !important;
        }

    .form-label {
        color: #00e5ff; /* GTAuto Cyan */
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1.5px;
        font-weight: 800;
        margin-bottom: 8px;
        display: block;
        text-align: left;
    }

    .btn-save {
        background-color: #00e5ff; /* GTAuto Cyan */
        color: #000;
        border: none;
        padding: 14px 50px;
        font-weight: 900;
        text-transform: uppercase;
        border-radius: 4px;
        transition: 0.3s;
        letter-spacing: 1px;
    }

        .btn-save:hover {
            background-color: #00b8cc;
            transform: translateY(-2px);
            box-shadow: 0 0 20px rgba(0, 229, 255, 0.4);
        }

    .image-update-section {
        background-color: #050505; /* Чисто, неутрално тъмно */
        border: 1px dashed #333;
        border-radius: 10px;
        padding: 20px;
        margin: 25px 0;
    }

    input[type=file]::file-selector-button {
        background-color: #1a1a1a;
        color: white;
        border: 1px solid #333;
        padding: 8px 15px;
        border-radius: 4px;
        margin-right: 15px;
        transition: 0.3s;
    }

        input[type=file]::file-selector-button:hover {
            background-color: #00e5ff;
            color: black;
            border-color: #00e5ff;
        }
</style>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 edit-card">
            <h2 class="text-white fw-bold mb-4 text-uppercase" style="letter-spacing: 2px;">
                Edit <span style="color: #00e5ff;">Asset Details</span>
            </h2>
            <hr style="border-color: #1a1a1a;" />

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row g-4 text-start">
                    @* МОДЕЛ *@
                    <div class="col-md-12">
                        <label class="form-label">Vehicle Model</label>
                        <select asp-for="ModelId" class="form-control form-select" asp-items="ViewBag.Models"></select>
                        <span asp-validation-for="ModelId" class="text-danger"></span>
                    </div>

                    @* ОСНОВНИ ДАННИ *@
                    <div class="col-md-3">
                        <label asp-for="Year" class="form-label">Year</label>
                        <input asp-for="Year" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="HorsePower" class="form-label">Power (HP)</label>
                        <input asp-for="HorsePower" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Price" class="form-label">Price (€)</label>
                        <input asp-for="Price" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Mileage" class="form-label">Mileage (km)</label>
                        <input asp-for="Mileage" class="form-control" />
                    </div>

                    @* ТЕХНИЧЕСКИ ДАННИ *@
                    <div class="col-md-4">
                        <label asp-for="FuelType" class="form-label">Fuel Type</label>
                        <input asp-for="FuelType" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Transmission" class="form-label">Transmission</label>
                        <input asp-for="Transmission" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Color" class="form-label">Color</label>
                        <input asp-for="Color" class="form-control" />
                    </div>

                    @* СНИМКИ *@
                    <div class="col-12">
                        <div class="image-update-section">
                            <h5 class="text-white small fw-bold text-uppercase mb-1">Update Photography</h5>
                            <p class="text-muted small mb-4 fst-italic">Leave empty to keep the current images stored in the system.</p>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label" style="color: #666;">Front View</label>
                                    <input type="file" asp-for="FrontImage" class="form-control" accept="image/*" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" style="color: #666;">Rear View</label>
                                    <input type="file" asp-for="BackImage" class="form-control" accept="image/*" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" style="color: #666;">Interior</label>
                                    <input type="file" asp-for="InteriorImage" class="form-control" accept="image/*" />
                                </div>
                            </div>
                        </div>
                    </div>

                    @* ОПИСАНИЕ *@
                    <div class="col-12">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>

                    @* СТАТУСИ *@
                    <div class="col-12">
                        <div class="d-flex flex-wrap gap-4 mt-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsFlashOffer" style="border-color: #333; cursor: pointer;">
                                <label class="form-check-label fw-bold" asp-for="IsFlashOffer" style="cursor: pointer; letter-spacing: 1px; color: #00e5ff;">
                                    🔥 FLASH OFFER
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                @* БУТОНИ *@
                <div class="text-center mt-5">
                    <button type="submit" class="btn btn-save">Save Changes</button>
                    <div class="mt-4">
                        <a asp-action="Index" class="text-muted text-decoration-none small fw-bold" style="letter-spacing: 1px; transition: 0.3s;" onmouseover="this.style.color='#00e5ff'" onmouseout="this.style.color='#6c757d'">
                            CANCEL AND BACK TO LIST
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}