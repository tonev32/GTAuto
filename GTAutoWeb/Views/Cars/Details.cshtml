@model GTAuto.Data.Models.Car

@{
    ViewData["Title"] = "Vehicle Details";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-center fw-bold text-uppercase mt-3" style="border: 2px solid #ff4d4d; background-color: #1a0000; color: #ff4d4d;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
    </div>
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    /* 🔥 ТОТАЛНО ЗАТЪМНЯВАНЕ 🔥 */
    html, body, main, .container, .container-fluid, .pb-3,
    header, footer, .footer, .navbar, nav {
        background-color: #000000 !important;
        background: #000000 !important;
    }

    header, footer, .footer, .navbar, .border-top, .border-bottom {
        border-color: #0a0a0a !important;
        box-shadow: none !important;
    }

    .details-container {
        margin-top: 40px;
        margin-bottom: 60px;
    }

    /* КАРТИ ЗА СПЕЦИФИКАЦИИ */
    .spec-card {
        background-color: #0d0d0d;
        border: 1px solid #1a1a1a;
        border-radius: 10px;
        padding: 12px;
        height: 100%;
        transition: transform 0.2s ease;
    }

        .spec-card:hover {
            border-color: #28a745;
        }

    .spec-icon {
        color: #28a745;
        font-size: 1.1rem;
        margin-right: 8px;
    }

    .spec-label {
        color: #8c8c8c;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .spec-value {
        color: #ffffff;
        font-size: 1.1rem;
        font-weight: 700;
    }

    /* ОПИСАНИЕ */
    .desc-card {
        background-color: transparent;
        border: 1px solid #1a1a1a;
        border-radius: 8px;
        padding: 18px;
        margin-top: 25px;
    }

    /* 🏷️ ЦЕНА - КОМПАКТНА И СТИЛНА */
    .price-section-simple {
        background-color: #050505;
        border: 1px solid #1a1a1a;
        border-left: 4px solid #28a745;
        border-radius: 8px;
        padding: 15px 20px;
        margin-top: 15px;
        display: flex;
        flex-direction: column;
    }

    .price-value-simple {
        color: #28a745;
        font-size: 2.2rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: -1px;
    }

    /* ГАЛЕРИЯ */
    .gallery-container {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #1a1a1a;
    }

    .carousel-item img {
        height: 480px;
        object-fit: cover;
    }

    /* 🔥 ЗЕЛЕН БУТОН ЗА ПОКУПКА 🔥 */
    .btn-buy-now {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 15px;
        font-weight: 800;
        text-transform: uppercase;
        border-radius: 8px;
        transition: 0.3s;
        display: block;
        width: 100%;
        text-decoration: none;
        text-align: center;
        letter-spacing: 1px;
    }

        .btn-buy-now:hover {
            background-color: #218838;
            box-shadow: 0 0 15px rgba(40, 167, 69, 0.3);
            color: white;
        }

    /* 🔥 СИН БУТОН ЗА НАЗАД 🔥 */
    .btn-back {
        display: inline-block;
        color: #00d4ff;
        border: 1px solid #00d4ff;
        background-color: rgba(0, 212, 255, 0.05);
        padding: 10px 22px;
        text-decoration: none;
        font-weight: 700;
        text-transform: uppercase;
        border-radius: 6px;
        transition: all 0.3s ease;
        font-size: 0.85rem;
        letter-spacing: 1px;
    }

        .btn-back:hover {
            background-color: #00d4ff;
            color: #000 !important;
            transform: translateX(-5px);
            box-shadow: 0 0 15px rgba(0, 212, 255, 0.3);
        }
</style>

<div class="container details-container">
    <div class="row mb-4">
        <div class="col-12 text-start">
            <h1 class="text-white fw-bold mb-1" style="font-size: 3rem;">@Model.Model.Name</h1>
            <p style="color: #28a745; font-size: 1rem; letter-spacing: 2px; text-transform: uppercase; font-weight: 700;">
                Asset Verified | Premium Listing
            </p>
        </div>
    </div>

    <div class="row g-5">
        @* ЛЯВА КОЛОНА *@
        <div class="col-lg-5">
            <h3 class="text-muted mb-4 fw-bold border-bottom border-secondary pb-2 small text-uppercase">Specifications</h3>

            <div class="row g-3">
                <div class="col-6"><div class="spec-card"><div class="spec-label"><i class="bi bi-calendar-event spec-icon"></i> Year</div><div class="spec-value">@Model.Year</div></div></div>
                <div class="col-6"><div class="spec-card"><div class="spec-label"><i class="bi bi-speedometer2 spec-icon"></i> Mileage</div><div class="spec-value">@Model.Mileage.ToString("N0") km</div></div></div>
                <div class="col-6"><div class="spec-card"><div class="spec-label"><i class="bi bi-lightning-charge spec-icon"></i> Power</div><div class="spec-value">@Model.HorsePower HP</div></div></div>
                <div class="col-6"><div class="spec-card"><div class="spec-label"><i class="bi bi-fuel-pump spec-icon"></i> Fuel</div><div class="spec-value">@Model.FuelType</div></div></div>
                <div class="col-6"><div class="spec-card"><div class="spec-label"><i class="bi bi-gear-wide-connected spec-icon"></i> Gearbox</div><div class="spec-value">@Model.Transmission</div></div></div>
                <div class="col-6"><div class="spec-card"><div class="spec-label"><i class="bi bi-palette spec-icon"></i> Color</div><div class="spec-value">@Model.Color</div></div></div>
            </div>

            @* ТЕХНИЧЕСКО ОПИСАНИЕ *@
            <div class="desc-card">
                <div class="spec-label mb-2">Technical Description</div>
                <p class="text-white small m-0" style="line-height: 1.6; opacity: 0.8;">
                    @Model.Description
                </p>
            </div>

            @* ЦЕНА *@
            <div class="price-section-simple">
                <span class="spec-label">Asking Price</span>
                <h2 class="price-value-simple">@Model.Price.ToString("N0") €</h2>
            </div>

            @* СИН БУТОН НАЗАД - ПРИБРАН ПЛЪТНО ПОД ЦЕНАТА *@
            <div class="mt-4">
                <a asp-action="Index" class="btn-back">
                    <i class="bi bi-chevron-left me-1"></i> Return to Inventory
                </a>
            </div>
        </div>

        @* ДЯСНА КОЛОНА *@
        <div class="col-lg-7">
            <h3 class="text-muted mb-4 fw-bold border-bottom border-secondary pb-2 small text-uppercase">Vehicle Gallery</h3>
            <div class="gallery-container">
                <div id="carGallery" class="carousel slide carousel-fade" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @if (Model.Images != null && Model.Images.Any())
                        {
                            var sortedImages = Model.Images.OrderBy(i => i.Order).ToList();
                            for (int i = 0; i < sortedImages.Count; i++)
                            {
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="@sortedImages[i].ImagePath" class="d-block w-100" alt="View @(i+1)">
                                </div>
                            }
                        }
                    </div>
                    @if (Model.Images != null && Model.Images.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#carGallery" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carGallery" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
                    }
                </div>
            </div>

            @* ЗЕЛЕН БУТОН BUY NOW *@
            <div class="mt-4">
                <a asp-action="Checkout" asp-route-id="@Model.Id" class="btn-buy-now">
                    <i class="bi bi-cart-check-fill me-2"></i> Buy Now / Reserve Asset
                </a>
                <p class="text-center text-muted mt-2 mb-0 small" style="font-size: 0.75rem;">
                    Requires a 5% deposit. Asset held for 30 days for final payment at dealership.
                </p>
            </div>
        </div>
    </div>
</div>