@model IEnumerable<GTAuto.Data.Models.Car>

@{
    ViewData["Title"] = "Cars";
}

<h1>Cars</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<div class="row">
    @foreach (var car in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(car.ImageUrl))
                {
                    <img src="@car.ImageUrl" class="card-img-top" alt="@car.Model.Name" style="height:200px; object-fit:cover;">
                }
                <div class="card-body">
                    <h5 class="card-title">@car.Model.Name</h5>
                   
                </div>
                <div class="card-footer text-center">
                    @if (User.IsInRole("Admin"))
                    {

                <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-warning">Edit</a>

                        <a asp-action="Delete" asp-route-id="@car.Id" class="btn btn-sm btn-danger">Delete</a>
                    }
                    <a asp-action="Details" asp-route-id="@car.Id"
                       class="btn btn-sm text-white"
                       style="background-color:#19719c; border:none;">
                        Details
                    </a>
                </div>
            </div>
        </div>
    }
</div>