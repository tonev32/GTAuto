@model IEnumerable<GTAuto.Data.Models.Car>

@{
    ViewData["Title"] = "Premium Inventory";
}

<style>
    /* ГЛАВЕН КОНТЕЙНЕР */
    .inventory-wrapper {
        background-color: #000000 !important;
        min-height: 100vh;
        padding: 60px 0;
    }

    .inventory-title {
        font-size: 4rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: -2px;
        color: #ffffff;
        margin-bottom: 10px;
    }

    .inventory-subtitle {
        color: #94a3b8;
        font-style: italic;
        margin-bottom: 50px;
    }

    /* БУТОН ЗА СЪЗДАВАНЕ */
    .btn-create-blue {
        background-color: #00d4ff;
        color: #000000;
        border: none;
        padding: 12px 30px;
        font-weight: 800;
        text-transform: uppercase;
        border-radius: 4px;
        transition: 0.3s;
        text-decoration: none;
        display: inline-block;
        margin-bottom: 40px;
    }

    /* ФИЛТРИ */
    .filter-form-invisible {
        background: transparent;
        margin-bottom: 60px;
        width: 100%;
    }

    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield;
    }

    .search-input-noir {
        background-color: #000000 !important;
        border: 1px solid #222 !important;
        color: white !important;
        padding: 10px 15px;
        border-radius: 4px !important;
        box-shadow: none !important;
        transition: 0.3s;
    }

        .search-input-noir:focus {
            border-color: #00d4ff !important;
        }

    .filter-label {
        color: #00d4ff;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 800;
        letter-spacing: 1.5px;
        margin-bottom: 10px;
        display: block;
        text-align: left;
        text-shadow: 0 0 10px rgba(0, 212, 255, 0.3);
    }

    .btn-search-blue {
        background-color: #00d4ff;
        color: #000;
        border: none;
        font-weight: 800;
        text-transform: uppercase;
        padding: 10px 25px;
        border-radius: 4px;
        transition: 0.3s;
    }

        .btn-search-blue:hover {
            background-color: #00aacc;
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
        }

    /* КАРТИТЕ */
    .car-card-noir {
        background: #0d0d0d;
        border: 1px solid #1a1a1a;
        transition: 0.4s;
        border-radius: 12px;
        position: relative;
        overflow: hidden;
    }

        .car-card-noir:hover {
            transform: translateY(-10px);
            border-color: #00d4ff;
        }

    .corner-ribbon {
        position: absolute;
        top: 20px;
        right: -35px;
        background-color: #ff0000;
        color: white;
        padding: 5px 40px;
        font-weight: bold;
        text-transform: uppercase;
        transform: rotate(45deg);
        z-index: 10;
        font-size: 0.75rem;
    }

    /* ==========================================
                    🔥 СТИЛОВЕ ЗА КАПАРИРАНА КОЛА 🔥
                    ========================================== */
    .reserved-card {
        filter: grayscale(100%) brightness(50%); /* Черно-бяла и тъмна */
        border-color: #222 !important;
    }

        /* Спираме ефекта на повдигане при посочване */
        .reserved-card:hover {
            transform: none !important;
            border-color: #222 !important;
        }

    /* Червеният диагонален печат */
    .reserved-badge {
        position: absolute;
        top: 40%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-15deg);
        background-color: rgba(15, 0, 0, 0.9);
        color: #ff3333;
        padding: 10px 40px;
        font-weight: 900;
        text-transform: uppercase;
        font-size: 2rem;
        letter-spacing: 5px;
        border: 3px solid #ff3333;
        z-index: 20;
        white-space: nowrap;
        pointer-events: none; /* За да не пречи на кликове (ако има) */
    }

    /* Сив блокиран бутон */
    .btn-disabled-noir {
        background-color: #1a1a1a !important;
        color: #555 !important;
        border: 2px solid #333 !important;
        cursor: not-allowed !important;
        border-radius: 4px;
    }
</style>

<div class="inventory-wrapper">
    <div class="container text-center">
        @* HEADER *@
        <h1 class="inventory-title">Premium <span style="color: #00d4ff; text-shadow: 0 0 20px rgba(0, 212, 255, 0.4);">Inventory</span></h1>
        <p class="inventory-subtitle">Explore our curated collection of high-performance automobiles</p>

        @* ФИЛТРИ *@
        <form asp-controller="Cars" asp-action="Index" method="get" class="filter-form-invisible">
            <div class="row g-4 align-items-end">
                <div class="col-md-4">
                    <label class="filter-label">Brand / Model</label>
                    <input type="text" name="searchString" value="@ViewData["CurrentSearch"]"
                           class="form-control search-input-noir w-100" placeholder="Brand/Model" />
                </div>

                <div class="col-md-4">
                    <label class="filter-label text-start">Horsepower (HP)</label>
                    <div class="input-group">
                        <input type="number" name="minHP" value="@ViewData["MinHP"]" class="form-control search-input-noir" placeholder="min HP" />
                        <input type="number" name="maxHP" value="@ViewData["maxHP"]" class="form-control search-input-noir" placeholder="max HP" />
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="filter-label">Price Range (€)</label>
                    <div class="d-flex gap-2">
                        <input type="number" name="minPrice" value="@ViewData["MinPrice"]" class="form-control search-input-noir" placeholder="min" style="width: 30%;" />
                        <input type="number" name="maxPrice" value="@ViewData["maxPrice"]" class="form-control search-input-noir" placeholder="max" style="width: 30%;" />

                        <button type="submit" class="btn btn-search-blue flex-grow-1">
                            APPLY
                        </button>
                    </div>
                </div>
            </div>

            @if (ViewData["CurrentSearch"] != null || ViewData["MinPrice"] != null || ViewData["MaxPrice"] != null || ViewData["MinHP"] != null || ViewData["MaxHP"] != null)
            {
                <div class="text-end mt-2">
                    <a asp-action="Index" class="fw-bold text-decoration-none small"
                           style="color: #00d4ff; font-size: 0.7rem; opacity: 0.8;"
                           onmouseover="this.style.opacity='1'; this.style.textDecoration='underline';"
                           onmouseout="this.style.opacity='0.8'; this.style.textDecoration='none';">
                        RESET FILTERS [X]
                    </a>
                </div>
            }
        </form>

        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <div class="text-start">
                <a asp-action="Create" class="btn-create-blue">+ Add New Asset</a>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-5 mt-4">
                <h2 class="text-muted fw-bold mb-3" style="letter-spacing: 2px;">NO ASSETS FOUND</h2>
                <p class="text-secondary fs-5">No vehicles matching your criteria were found.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-3 g-4 text-start">
                @foreach (var car in Model)
                {
                    var mainImg = car.Images?.OrderBy(i => i.Order).FirstOrDefault()?.ImagePath ?? "/images/no-image.png";

                    <div class="col">
                        @* ДОБАВЯМЕ КЛАСА reserved-card. АКО Е КАПАРИРАНА, МАХАМЕ ТРИГЕРА ЗА МОДАЛА *@
                        <div class="card car-card-noir h-100 @(car.IsReserved ? "reserved-card" : "")"
                            @(car.IsReserved ? "" : $"data-bs-toggle=\"modal\" data-bs-target=\"#modal-{car.Id}\"")>

                            @* ПРОВЕРКА ЗА ЕТИКЕТИ *@
                            @if (car.IsReserved)
                            {
                                <div class="reserved-badge">RESERVED</div>
                            }
                            else if (car.IsFlashOffer)
                            {
                                <div class="corner-ribbon">SALE</div>
                            }

                            @* ========================================================= *@
                            @* 🔥 ИНТЕЛИГЕНТНОТО СЪРЦЕ *@
                            @* ========================================================= *@
                            @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                            {
                                @* Админите нямат нужда от любими *@
                            }
                            else if (User.Identity.IsAuthenticated)
                            {
                                var favoriteIds = ViewBag.FavoriteCars as List<Guid> ?? new List<Guid>();
                                bool isAlreadyFavorite = favoriteIds.Contains(car.Id);

                                if (isAlreadyFavorite)
                                {
                                    @* 🔥 ЧЕРВЕНО СЪРЦЕ (Колата Е в любими) -> Бутон за премахване *@
                                    <form asp-controller="Wishlist" asp-action="Remove" asp-route-carId="@car.Id" method="post" class="position-absolute" style="top: 15px; left: 15px; z-index: 40;">
                                        <button type="submit" class="btn btn-dark bg-opacity-75 rounded-circle border-0 shadow-sm"
                                                style="width: 42px; height: 42px; transition: 0.3s; color: #ff3333; display: flex; justify-content: center; align-items: center;"
                                                onmouseover="this.style.transform='scale(1.1)';"
                                                onmouseout="this.style.transform='scale(1)';"
                                                title="Remove from Garage" onclick="event.stopPropagation();">
                                            <i class="bi bi-heart-fill fs-5" style="filter: drop-shadow(0 0 5px rgba(255,51,51,0.6));"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    @* 🤍 БЯЛО СЪРЦЕ (Колата НЕ Е в любими) -> Бутон за добавяне *@
                                    <form asp-controller="Wishlist" asp-action="Add" asp-route-carId="@car.Id" method="post" class="position-absolute" style="top: 15px; left: 15px; z-index: 40;">
                                        <button type="submit" class="btn btn-dark bg-opacity-75 rounded-circle border-0 shadow-sm"
                                                style="width: 42px; height: 42px; transition: 0.3s; color: white; display: flex; justify-content: center; align-items: center;"
                                                onmouseover="this.style.color='#ff3333'; this.style.transform='scale(1.1)';"
                                                onmouseout="this.style.color='white'; this.style.transform='scale(1)';"
                                                title="Add to Garage" onclick="event.stopPropagation();">
                                            <i class="bi bi-heart fs-5"></i>
                                        </button>
                                    </form>
                                }
                            }
                            else
                            {
                                @* БУТОН ЗА НЕЛОГНАТИ ПОТРЕБИТЕЛИ *@
                                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-dark bg-opacity-75 rounded-circle border-0 shadow-sm position-absolute"
                                       style="top: 15px; left: 15px; z-index: 40; width: 42px; height: 42px; transition: 0.3s; color: white; display: flex; justify-content: center; align-items: center; text-decoration: none;"
                                       onmouseover="this.style.color='#ff3333'; this.style.transform='scale(1.1)';"
                                       onmouseout="this.style.color='white'; this.style.transform='scale(1)';"
                                       title="Login to save" onclick="event.stopPropagation();">
                                    <i class="bi bi-heart fs-5"></i>
                                </a>
                            }
                            @* ========================================================= *@

                            <img src="@mainImg" class="card-img-top" alt="@car.Model.Name" style="height: 250px; object-fit: cover;">

                            <div class="card-body p-4">
                                <h5 class="card-title text-white fw-bold mb-1" style="font-size: 1.4rem;">@car.Model.Name</h5>
                                <p class="card-text mb-3" style="color: #8c8c8c; font-size: 0.85rem;">
                                    Year: @car.Year | HP: @car.HorsePower | Fuel: @car.FuelType
                                </p>

                                @if (car.IsFlashOffer && !car.IsReserved)
                                {
                                    <div class="text-muted text-decoration-line-through small">@((car.Price + 15000).ToString("N0")) €</div>
                                    <div style="color: #ff0000; font-weight: 800; font-size: 1.6rem;">@car.Price.ToString("N0") €</div>
                                }
                                else
                                {
                                    <div style="color: #00d4ff; font-weight: 800; font-size: 1.6rem;">@car.Price.ToString("N0") €</div>
                                }
                            </div>

                            <div class="card-footer bg-transparent border-0 pb-4 px-4 text-center" onclick="event.stopPropagation();">

                                @* АКО Е КАПАРИРАНА - БЛОКИРАН БУТОН. АКО НЕ Е - БУТОН DETAILS *@
                                @if (car.IsReserved)
                                {
                                    <button class="btn btn-disabled-noir w-100 fw-bold py-2" disabled>
                                        UNAVAILABLE
                                    </button>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-route-id="@car.Id" class="btn btn-outline-info w-100 fw-bold py-2" style="border-radius: 4px; border-width: 2px;">
                                        DETAILS
                                    </a>
                                }

                                @* АДМИН БУТОНИТЕ СИ ОСТАВАТ АКТИВНИ *@
                                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                                {
                                    <div class="d-flex gap-2 justify-content-center mt-3">
                                        <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@car.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    @* Модалът се рендира само ако колата НЕ е капарирана *@
                    @if (!car.IsReserved)
                    {
                        <div class="modal fade" id="modal-@car.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                <div class="modal-content" style="background-color: #0a0a0a; color: white; border: 1px solid #1a1a1a;">
                                    <div class="modal-header border-0">
                                        <h5 class="modal-title fw-bold">@car.Model.Name</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body p-4 text-center">
                                        <img src="@mainImg" class="img-fluid rounded mb-4" style="width: 100%; height: 400px; object-fit: cover;">

                                        <div class="row text-center g-3">
                                            <div class="col-4 border-end border-secondary">
                                                <small class="text-muted d-block">YEAR</small>
                                                <strong class="fs-5">@car.Year</strong>
                                            </div>
                                            <div class="col-4 border-end border-secondary">
                                                <small class="text-muted d-block">HORSEPOWER</small>
                                                <strong class="fs-5">@car.HorsePower HP</strong>
                                            </div>
                                            <div class="col-4">
                                                <small class="text-muted d-block">PRICE</small>
                                                <strong class="fs-5" style="color: @(car.IsFlashOffer ? "#ff0000" : "#00d4ff")">@car.Price.ToString("N0") €</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>