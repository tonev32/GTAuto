@model IEnumerable<GTAuto.Data.Models.Car>

@{
    ViewData["Title"] = "Premium Inventory";
}

<style>
    /* ГЛАВЕН КОНТЕЙНЕР - ЧИСТО ЧЕРНО */
    .inventory-wrapper {
        background-color: #000000 !important;
        min-height: 100vh;
        padding: 60px 0;
    }

    .inventory-title {
        font-size: 4rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: -2px;
        color: #ffffff;
        margin-bottom: 10px;
    }

    .inventory-subtitle {
        color: #94a3b8;
        font-style: italic;
        margin-bottom: 50px;
    }

    /* БУТОН ЗА СЪЗДАВАНЕ (АДМИН) */
    .btn-create-blue {
        background-color: #00d4ff;
        color: #000000;
        border: none;
        padding: 15px 35px;
        font-weight: 800;
        text-transform: uppercase;
        border-radius: 4px;
        transition: 0.3s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-create-blue:hover {
            background-color: #00aacc;
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.4);
            color: #000000;
        }

    /* КАРТИТЕ НА КОЛИТЕ */
    .car-card-noir {
        background: #0d0d0d;
        border: 1px solid #1a1a1a;
        transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border-radius: 12px;
        cursor: pointer;
        /* Важно за лентата: */
        position: relative;
        overflow: hidden;
    }

        .car-card-noir:hover {
            transform: translateY(-10px);
            border-color: #00d4ff;
            box-shadow: 0 10px 30px rgba(0, 212, 255, 0.15);
        }

    .price-text-blue {
        color: #00d4ff;
        font-weight: 800;
        font-size: 1.6rem;
    }

    /* БУТОН DETAILS */
    .btn-details-blue {
        border: 2px solid #00d4ff;
        color: #00d4ff;
        font-weight: 800;
        text-transform: uppercase;
        padding: 8px 25px;
        transition: 0.3s;
        border-radius: 4px;
        text-decoration: none;
        display: inline-block;
    }

        .btn-details-blue:hover {
            background: #00d4ff;
            color: #000000;
            box-shadow: 0 0 15px rgba(0, 212, 255, 0.4);
        }

    /* ТЪРСАЧКА */
    .search-input-noir {
        background-color: #0d0d0d !important;
        border: 1px solid #333 !important;
        color: white !important;
        padding: 15px 20px;
        border-radius: 4px 0 0 4px;
        box-shadow: none !important;
        transition: 0.3s;
    }

        .search-input-noir:focus {
            border-color: #00d4ff !important;
            box-shadow: 0 0 15px rgba(0, 212, 255, 0.2) !important;
        }

    .btn-search-blue {
        background-color: #00d4ff;
        color: #000;
        border: none;
        border-radius: 0 4px 4px 0;
        transition: 0.3s;
    }

        .btn-search-blue:hover {
            background-color: #00aacc;
            box-shadow: 0 0 15px rgba(0, 212, 255, 0.4);
        }
</style>

<div class="inventory-wrapper">
    <div class="container text-center">
        @* HEADER СЕКЦИЯ *@
        <h1 class="inventory-title">Premium <span style="color: #00d4ff; text-shadow: 0 0 20px rgba(0, 212, 255, 0.4);">Inventory</span></h1>
        <p class="inventory-subtitle">Explore our curated collection of high-performance automobiles</p>

        @* 🔥 СЕКЦИЯ ЗА ТЪРСЕНЕ 🔥 *@
        <div class="row justify-content-center mb-5">
            <div class="col-md-8 col-lg-6">
                <form asp-controller="Cars" asp-action="Index" method="get">
                    <div class="input-group">
                        <input type="text" name="searchString" value="@ViewData["CurrentSearch"]"
                               class="form-control search-input-noir"
                               placeholder="Search by brand or model" />

                        <button type="submit" class="btn btn-search-blue px-4">
                            <strong style="letter-spacing: 1px;">SEARCH</strong>
                        </button>

                        @* Изчистен текст за CLEAR *@
                        @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()))
                        {
                            <a asp-controller="Cars" asp-action="Index"
                               class="d-flex align-items-center ms-3 fw-bold text-decoration-none"
                               style="color: #00d4ff; transition: 0.3s;"
                               onmouseover="this.style.textDecoration='underline'"
                               onmouseout="this.style.textDecoration='none'">
                                CLEAR
                            </a>
                        }
                    </div>
                </form>
            </div>
        </div>

        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <div class="mb-5">
                <a asp-action="Create" class="btn-create-blue">+ Create New Listing</a>
            </div>
        }

        @* 🔥 ПРОВЕРКА ДАЛИ ИМА НАМЕРЕНИ КОЛИ 🔥 *@
        @if (!Model.Any())
        {
            <div class="text-center py-5 mt-4" style="background-color: transparent; max-width: 800px; margin: 0 auto;">
                <h2 class="text-muted fw-bold mb-3" style="letter-spacing: 2px;">NO ASSETS FOUND</h2>

                @if (ViewData["CurrentSearch"] != null)
                {
                    <p class="text-secondary fs-5">We couldn't find any vehicles matching "<strong class="text-white">@ViewData["CurrentSearch"]</strong>".</p>
                }
                else
                {
                    <p class="text-secondary fs-5">The inventory is currently empty.</p>
                }
            </div>
        }
        else
        {
            @* ГРИД С КОЛИ (АКО ИМА РЕЗУЛТАТИ) *@
            <div class="row row-cols-1 row-cols-md-3 g-4 text-start">
                @foreach (var car in Model)
                {
                    <div class="col">
                        <div class="card car-card-noir h-100" data-bs-toggle="modal" data-bs-target="#modal-@car.Id">

                            @if (car.IsFlashOffer)
                            {
                                <div class="corner-ribbon">SALE</div>
                            }

                            @if (!string.IsNullOrEmpty(car.ImageUrl))
                            {
                                <img src="@car.ImageUrl" class="card-img-top" alt="@car.Model.Name" style="height: 250px; object-fit: cover;">
                            }

                            <div class="card-body">
                                <h5 class="card-title text-white fw-bold mb-1" style="font-size: 1.4rem;">@car.Model.Name</h5>
                                <p class="card-text mb-3" style="color: #8c8c8c; font-size: 0.9rem;">
                                    Year: @car.Year | Fuel: @car.FuelType
                                </p>

                                @if (car.IsFlashOffer)
                                {
                                    <div class="text-muted text-decoration-line-through mb-1" style="font-size: 1rem;">
                                        @((car.Price + 15000).ToString("N0")) €
                                    </div>
                                    <div class="price-text-blue" style="color: #ff0000;">
                                        @car.Price.ToString("N0") €
                                    </div>
                                }
                                else
                                {
                                    <div class="price-text-blue">
                                        @car.Price.ToString("N0") €
                                    </div>
                                }
                            </div>

                            <div class="card-footer bg-transparent border-0 pb-4 text-center" onclick="event.stopPropagation();">
                                <a asp-action="Details" asp-route-id="@car.Id" class="btn-details-blue mb-3">
                                    Details
                                </a>

                                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                                {
                                    <div class="d-flex gap-2 justify-content-center mt-2">
                                        <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@car.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    @* MODAL ЗА ВСЯКА КОЛА *@
                    <div class="modal fade" id="modal-@car.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content" style="background-color: #0a0a0a; color: white; border: 1px solid #1a1a1a; box-shadow: 0 0 30px rgba(0,0,0,0.8);">
                                <div class="modal-header border-secondary" style="border-bottom: 1px solid #1a1a1a !important;">
                                    <h5 class="modal-title fw-bold text-uppercase">@car.Model.Name</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    @if (!string.IsNullOrEmpty(car.ImageUrl))
                                    {
                                        <img src="@car.ImageUrl" class="img-fluid rounded mb-4 shadow" style="width: 100%; height: 450px; object-fit: cover;">
                                    }
                                    <div class="row text-center g-3">
                                        <div class="col-4">
                                            <div class="p-3 border rounded" style="background-color: #0d0d0d; border-color: #1a1a1a !important;">
                                                <small class="text-uppercase text-muted" style="letter-spacing: 1px;">Year</small><br />
                                                <strong class="fs-5 text-white">@car.Year</strong>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-3 border rounded" style="background-color: #0d0d0d; border-color: #1a1a1a !important;">
                                                <small class="text-uppercase text-muted" style="letter-spacing: 1px;">Fuel</small><br />
                                                <strong class="fs-5 text-white">@car.FuelType</strong>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-3 border rounded" style="background-color: #0d0d0d; border-color: #1a1a1a !important;">
                                                <small class="text-uppercase text-muted" style="letter-spacing: 1px;">Price</small><br />

                                                @if (car.IsFlashOffer)
                                                {
                                                    <div class="text-muted text-decoration-line-through" style="font-size: 0.9rem;">
                                                        @((car.Price + 15000).ToString("N0")) €
                                                    </div>
                                                    <strong class="fs-5" style="color: #ff0000;">@car.Price.ToString("N0") €</strong>
                                                }
                                                else
                                                {
                                                    <strong class="fs-5" style="color: #00d4ff;">@car.Price.ToString("N0") €</strong>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>