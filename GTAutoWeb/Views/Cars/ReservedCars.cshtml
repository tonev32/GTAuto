@model IEnumerable<GTAuto.Data.Models.Reservation>

@{
    ViewData["Title"] = "Locked Assets Management";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    
    .admin-wrapper {
        background-color: #000000 !important;
        min-height: 100vh;
        padding: 60px 0;
    }

    .admin-title {
        font-size: 3.5rem;
        font-weight: 900;
        text-transform: uppercase;
        color: #ffffff;
        letter-spacing: -1px;
    }

    .accent-red {
        color: #ff3333;
        text-shadow: 0 0 15px rgba(255, 51, 51, 0.5);
    }

    .car-card-admin {
        background: #0d0d0d;
        border: 1px solid #1a1a1a;
        border-radius: 12px;
        overflow: hidden;
        position: relative;
        transition: all 0.4s ease-out;
    }

        .car-card-admin:hover {
            transform: translateY(-4px);
            border-color: #ff3333 !important;
            box-shadow: 0 5px 20px rgba(255, 51, 51, 0.2);
        }

    .img-container {
        position: relative;
        height: 220px;
        overflow: hidden;
    }

    .card-img-admin {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease-in-out;
    }

    .car-card-admin:hover .card-img-admin {
        transform: scale(1.03);
    }

    .date-info-btn {
        position: absolute;
        top: 15px;
        left: 15px;
        background: rgba(0, 0, 0, 0.7);
        color: #ff3333;
        border: 1px solid #ff3333;
        border-radius: 50%;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 30;
        transition: 0.3s;
        backdrop-filter: blur(5px);
    }

        .date-info-btn:hover {
            background: #ff3333;
            color: #fff;
            box-shadow: 0 0 10px #ff3333;
        }

    .price-tag {
        color: #ff3333;
        font-weight: 900;
        font-size: 1.5rem;
        margin-top: 10px;
    }

    .btn-unlock {
        background-color: #ff3333;
        color: white;
        border: none;
        padding: 15px;
        font-weight: 900;
        text-transform: uppercase;
        width: 100%;
        transition: 0.3s;
        letter-spacing: 1px;
    }

        .btn-unlock:hover {
            background-color: #cc0000;
        }

    .badge-locked {
        background-color: rgba(255, 51, 51, 0.1);
        color: #ff3333;
        border: 1px solid #ff3333;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        padding: 5px 10px;
    }

    
    .swal2-popup {
        background: #0d0d0d !important;
        border: 1px solid #ff3333 !important;
        border-radius: 15px !important;
        color: #fff !important;
    }
</style>

<div class="admin-wrapper">
    <div class="container text-center">
        <h1 class="admin-title">LOCKED <span class="accent-red">ASSETS</span></h1>
        <p class="text-muted mb-5 text-uppercase" style="letter-spacing: 3px; font-size: 0.8rem;">Security Protocol: Authorized Access Only</p>

        @if (!Model.Any())
        {
            <div class="py-5">
                <i class="bi bi-shield-lock text-secondary" style="font-size: 4rem;"></i>
                <h3 class="text-secondary fw-bold mt-3">NO RESERVED ASSETS FOUND</h3>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary mt-3 fw-bold px-4">RETURN TO SHOWROOM</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-3 g-4 text-start">
                @foreach (var res in Model)
                {
                    var mainImg = res.Car.Images?.OrderBy(i => i.Order).FirstOrDefault()?.ImagePath ?? "/images/no-image.png";
                    var daysLeft = (res.ExpiryDate - DateTime.UtcNow).Days;

                    <div class="col">
                        <div class="card car-card-admin h-100 shadow-lg">

                            <div class="date-info-btn"
                                 data-bs-toggle="popover"
                                 data-bs-trigger="hover focus"
                                 title="Reservation Details"
                                 data-bs-content="Deadline: @res.ExpiryDate.ToString("dd MMM yyyy"). Status: @daysLeft days until automatic release.">
                                <i class="bi bi-info-lg"></i>
                            </div>

                            <div class="img-container">
                                <img src="@mainImg" class="card-img-admin" alt="Vehicle Image">
                            </div>

                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h4 class="text-white fw-bold mb-0">@res.Car.Model.Name</h4>
                                    <span class="badge badge-locked">
                                        @daysLeft Days Left
                                    </span>
                                </div>
                                <p class="text-muted small mb-0">ASSET ID: @res.CarId.ToString().ToUpper().Substring(0, 8)</p>

                                <div class="price-tag">@res.Car.Price.ToString("N0") €</div>
                            </div>

                            <div class="card-footer bg-transparent border-0 p-0">
                             
                                <form asp-action="CancelReservation" asp-route-id="@res.Id" method="post" onsubmit="return confirmUnlock(this);">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-unlock">
                                        <i class="bi bi-unlock-fill me-2"></i> UNLOCK ASSET
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
       
        var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'))
        var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
            return new bootstrap.Popover(popoverTriggerEl)
        })

      
        function confirmUnlock(form) {
            Swal.fire({
                title: 'SECURITY PROTOCOL',
                text: "Are you sure you want to release this asset back to the showroom?",
                icon: 'warning',
                iconColor: '#ff3333',
                showCancelButton: true,
                confirmButtonColor: '#ff3333',
                cancelButtonColor: '#333',
                confirmButtonText: 'CONFIRM UNLOCK',
                cancelButtonText: 'CANCEL',
                background: '#0d0d0d',
                color: '#fff'
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
            return false;
        }
    </script>
}