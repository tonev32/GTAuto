@model GTAuto.Data.Models.Model

@{
    ViewData["Title"] = "Delete Model";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 100vh; padding: 40px 0; background-color: #000 !important;">
    <div class="card p-5 shadow-lg" style="background: #0d0d0d; border: 1px solid #330000; border-radius: 12px; width: 100%; max-width: 500px;">
        <div class="text-center mb-4">
            <div class="text-danger mb-3" style="font-size: 3rem;">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h2 class="text-white fw-bold mb-1">DELETE <span style="color: #ff3333; text-shadow: 0 0 10px rgba(255,51,51,0.4);">ASSET</span></h2>
            <p class="text-muted small">This action cannot be undone.</p>
        </div>

        <div class="text-center mb-5 p-4" style="background: #000; border: 1px solid #1a1a1a; border-radius: 8px;">
            <span style="color: #666; font-size: 0.75rem; text-transform: uppercase; font-weight: 800; letter-spacing: 1px;">Selected Model</span>
            <h3 class="text-white fw-bold mt-2 mb-0">@Html.DisplayFor(model => model.Name)</h3>
        </div>

        <form asp-action="Delete" class="d-flex gap-3">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="btn btn-outline-secondary w-50 fw-bold text-uppercase py-2" style="border-radius: 4px;">
                Cancel
            </a>
            <button type="submit" class="btn btn-danger w-50 fw-bold text-uppercase py-2" style="border-radius: 4px; transition: 0.3s;" onmouseover="this.style.boxShadow='0 0 15px rgba(255,51,51,0.5)'" onmouseout="this.style.boxShadow='none'">
                <i class="bi bi-trash3-fill me-1"></i> Confirm Delete
            </button>
        </form>
    </div>
</div>