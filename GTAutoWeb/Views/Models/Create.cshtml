@model GTAutoWeb.ViewModel.ModelViewModel

<div class="container mt-5">
    <div class="card bg-dark text-white p-4">
        <h2>Add Vehicle (Brand & Model)</h2>
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label">Enter Brand and Model (e.g. Audi RS6)</label>
                <input asp-for="Name" class="form-control bg-secondary text-white" placeholder="Write here..." />
            </div>

            <input type="hidden" name="BrandId" value="@ViewBag.BrandId" />

            <button type="submit" class="btn btn-danger">Save Vehicle</button>
        </form>
    </div>
</div>