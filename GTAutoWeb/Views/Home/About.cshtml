@{
    ViewData["Title"] = "About Us - GTAuto Prestige";
}

<style>
    /* ТОВА УБИВА СИНЬО-ЗЕЛЕНИЯ ФОН И ПРАВИ ВСИЧКО ЧЕРНО */
    .about-wrapper {
        background-color: #000000 !important;
        min-height: 100vh; /* Гарантира, че черното стига до самия футър */
        padding-bottom: 80px;
    }

    /* ЧИСТО ЧЕРЕН ФОН за горната част */
    .story-hero {
        height: 40vh;
        background-color: #000000;
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid rgba(0, 212, 255, 0.2);
    }

        .story-hero h1 {
            font-size: 5rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: -2px;
            color: #ffffff;
        }

    /* СИНЯТА СВЕТЛИНА */
    .blue-glow {
        color: #00d4ff;
        text-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
    }

    .owner-section {
        border-left: 4px solid #00d4ff;
        background-color: transparent;
        padding: 40px;
    }
</style>

<div class="about-wrapper">

    <div class="story-hero text-center">
        <h1>Our <span class="blue-glow">Legacy</span></h1>
    </div>

    <div class="container py-5 mt-4">
        <div class="row g-5 align-items-center mb-5">
            <div class="col-lg-6">
                <h2 class="display-5 fw-800 text-uppercase text-white mb-4">A History of <span style="color: #00d4ff;">Power</span></h2>
                <div class="text-muted fs-5 lh-lg">
                    <p>GTAuto was founded as a private sanctuary for high-performance automotive art. Every vehicle housed within our showroom is hand-picked for mechanical perfection and undisputed status.</p>
                    <p>From rare M-series icons to the latest track-focused editions, we provide our global clientele with immediate access to inventory that defines the pinnacle of engineering.</p>
                </div>
            </div>
            <div class="col-lg-6">
                
                <img src="~/images/outside.png" class="img-fluid rounded-3 shadow-lg" style="border: 1px solid #1a1a1a; filter: brightness(0.6) contrast(1.2);">
            </div>
        </div>

        <div class="row g-5 mt-5 align-items-center">
            <div class="col-lg-5">

                <img src="~/images/Owner.jpg" class="img-fluid rounded-3 shadow-lg" style="filter: grayscale(100%) brightness(0.7); border: 1px solid #1a1a1a;">
            </div>
            <div class="col-lg-7">
                <div class="owner-section">
                    <h2 class="display-6 fw-800 mb-2 text-white">ALEX PETROV</h2>
                    <p class="text-muted h4 fw-light fst-italic mb-4">"We don't sell transport. We sell legends. If a car doesn't have a soul that moves the spirit, it doesn't belong in GTAuto."</p>
                    <p class="text-uppercase fw-bold tracking-widest small mb-0" style="color: #00d4ff;">Founder & CEO</p>
                </div>
            </div>
        </div>
    </div>

</div>

