@{
    ViewData["Title"] = "About Us - GTAuto Prestige";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    .about-wrapper {
        background-color: #000000 !important;
        min-height: 100vh;
        padding-bottom: 80px;
    }

    .story-hero {
        height: 40vh;
        background-color: #000000;
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid rgba(0, 212, 255, 0.2);
    }

        .story-hero h1 {
            font-size: 5rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: -2px;
            color: #ffffff;
        }

    .blue-glow {
        color: #00d4ff;
        text-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
    }

    /* СТИЛ ЗА СИНИТЕ ИКОНКИ */
    .contact-icon {
        color: #00d4ff;
        font-size: 1.5rem;
        margin-right: 15px;
        text-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
    }

    /* КВАДРАТНИ СНИМКИ СЪС ЗАОБЛЕНИ ЪГЛИ */
    .vip-image-square {
        width: 100%;
        max-width: 320px;
        height: 250px;
        object-fit: cover;
        border-radius: 20px; /* Заоблени ъгли */
        border: 2px solid #00d4ff;
        box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
        margin-bottom: 20px;
    }

    .vip-card {
        background: #0d0d0d;
        border: 1px solid #1a1a1a;
        transition: 0.4s;
        border-radius: 25px;
        padding: 30px;
        text-align: center;
        height: 100%;
    }

        .vip-card:hover {
            border-color: #00d4ff;
            transform: translateY(-10px);
        }

    .vip-car-tag {
        color: #00d4ff;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .owner-section {
        border-left: 4px solid #00d4ff;
        padding: 40px;
    }
</style>

<div class="about-wrapper">
    <div class="story-hero text-center">
        <h1>Our <span class="blue-glow">Legacy</span></h1>
    </div>

    <div class="container py-5">

        <div class="row g-5 align-items-center mb-5 pb-5 border-bottom border-dark">
            <div class="col-lg-6">
                <h2 class="display-5 fw-800 text-uppercase text-white mb-4">A History of <span style="color: #00d4ff;">Power</span></h2>
                <div class="text-muted fs-5">
                    <p>GTAuto was founded as a private sanctuary for high-performance automotive art. Every vehicle housed within our showroom is hand-picked for mechanical perfection.</p>
                </div>
            </div>
            <div class="col-lg-6">
                <img src="~/images/outside.png" class="img-fluid rounded-3 shadow-lg" style="border: 1px solid #1a1a1a; filter: brightness(0.7);">
            </div>
        </div>

        <div class="row g-5 align-items-center mb-5 pb-5 border-bottom border-dark">
            <div class="col-lg-5">
                <img src="~/images/Owner.jpg" class="img-fluid rounded-4" style="border: 1px solid #1a1a1a;">
            </div>
            <div class="col-lg-7">
                <div class="owner-section">
                    <h2 class="display-6 fw-800 text-white">ALEX PETROV</h2>
                    <p class="text-muted h4 fst-italic">"We don't sell transport. We sell legends."</p>
                    <p class="text-uppercase fw-bold" style="color: #00d4ff;">Founder & CEO</p>
                </div>
            </div>
        </div>

        <div class="row g-5 align-items-center mb-5 pb-5 border-bottom border-dark">
            <div class="col-lg-6">
                <h2 class="display-6 fw-800 text-uppercase text-white mb-4">The <span style="color: #00d4ff;">Showroom</span></h2>
                <div class="mt-4">
                    <p class="text-white d-flex align-items-center mb-3">
                        <i class="bi bi-geo-alt-fill contact-icon"></i>
                        Cherni Vrah Blvd, Sofia, Bulgaria
                    </p>
                    <p class="text-white d-flex align-items-center">
                        <i class="bi bi-telephone-fill contact-icon"></i>
                        +359 888 GT AUTO
                    </p>
                </div>
            </div>
            <div class="col-lg-6">
                @* ИСТИНСКА ГУГЪЛ КАРТА (СОФИЯ) *@
                <div class="rounded-4 overflow-hidden shadow-lg" style="border: 2px solid #1a1a1a;">
                    <iframe width="100%"
                            height="350"
                            frameborder="0"
                            scrolling="no"
                            marginheight="0"
                            marginwidth="0"
                            src="https://maps.google.com/maps?q=Cherni%20Vrah%20Sofia&t=k&z=15&ie=UTF8&iwloc=&output=embed">
                    </iframe>
                </div>
            </div>
        </div>

        <div class="text-center mb-5">
            <h2 class="display-5 fw-800 text-uppercase text-white">Trusted By <span class="blue-glow">Legends</span></h2>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-md-5">
                <div class="vip-card">
                    <img src="~/images/therock.jpg" class="vip-image-square" alt="The Rock">
                    <h3 class="text-white fw-bold">Dwayne "The Rock" Johnson</h3>
                    <p class="text-muted small">Global Hollywood icon and entrepreneur.</p>
                    <div class="mt-3 pt-3 border-top border-secondary">
                        <span class="vip-car-tag">BRABUS ML63 AMG</span>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="vip-card">
                    <img src="~/images/stalone.jpg" class="vip-image-square" alt="Stallone">
                    <h3 class="text-white fw-bold">Sylvester Stallone</h3>
                    <p class="text-muted small">Hollywood legend and avid car collector.</p>
                    <div class="mt-3 pt-3 border-top border-secondary">
                        <span class="vip-car-tag">BMW 7 SERIES (G11)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>