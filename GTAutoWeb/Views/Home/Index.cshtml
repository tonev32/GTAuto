@model IEnumerable<GTAuto.Data.Models.Car>

<style>
    .hero-e39 {
        height: 75vh;
        background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.9)), url('https://external-preview.redd.it/e39-night-gaze-v0-Ll4MTr-gO9BAwYcc3b2TYS5g-hXgk08754fKOCvkkmU.jpg?auto=webp&s=a96aaeacfa965028ac50fd76aaeab70a28b073f0');
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .hero-e39 h1 {
            font-size: 7rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: -3px;
        }

            .hero-e39 h1 span {
                color: #00d4ff;
                text-shadow: 0 0 30px #00d4ff, 0 0 60px rgba(0, 212, 255, 0.5);
            }

    .stats-bar {
        background-color: #080808;
        padding: 15px 0;
        border-bottom: 1px solid #151515;
    }

    .stat-text span {
        color: #00d4ff;
    }

    .offers-section {
        background-color: #000000 !important;
        padding: 100px 0;
    }

    .car-card-noir {
        background: #0d0d0d;
        border: 1px solid #1a1a1a;
        border-radius: 12px;
        transition: 0.4s;
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .car-card-noir:hover {
            border-color: #00d4ff;
            transform: translateY(-10px);
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.15);
        }

    .price-blue {
        color: #00d4ff;
        font-size: 1.8rem;
        font-weight: 800;
    }

    .btn-blue {
        background: #00d4ff;
        color: #000;
        font-weight: 800;
        text-transform: uppercase;
        padding: 12px;
        width: 100%;
        display: block;
        text-align: center;
        text-decoration: none;
    }

        .btn-blue:hover {
            background: #00aacc;
            box-shadow: 0 0 15px #00d4ff;
            color: #000;
        }

    .corner-ribbon {
        position: absolute;
        top: 20px;
        right: -35px;
        background-color: #ff0000;
        color: white;
        padding: 5px 40px;
        font-weight: bold;
        text-transform: uppercase;
        transform: rotate(45deg);
        z-index: 10;
        font-size: 0.75rem;
    }
</style>

<div class="hero-e39 text-center">
    <div>
        <p class="text-uppercase tracking-widest text-muted small mb-0">Built for the elite</p>
        <h1>GT<span>AUTO</span></h1>
    </div>
</div>

<div class="stats-bar">
    <div class="container">
        <div class="row text-center text-white">
            <div class="col-md-4 stat-text text-uppercase fw-bold">Max Single Order: <span>€1.2M</span></div>
            <div class="col-md-4 stat-text text-uppercase fw-bold">VIP Deliveries: <span>150+</span></div>
            <div class="col-md-4 stat-text text-uppercase fw-bold">Fastest Delivery: <span>48H</span></div>
        </div>
    </div>
</div>

<div class="offers-section">
    <div class="container text-white">
        <h2 class="display-4 fw-800 text-uppercase mb-5">Flash <span style="color: #00d4ff;">Offers</span></h2>

        <div class="row g-4">
            @foreach (var car in Model)
            {
                <div class="col-lg-4">
                    <div class="car-card-noir">

                        <div class="corner-ribbon">SALE</div>

                        @* 🔥 ПОПРАВКА НА РЕД 114: Използваме новата структура на снимките *@
                        @{
                            var mainImg = car.Images?.OrderBy(i => i.Order).FirstOrDefault()?.ImagePath ?? "/images/no-image.png";
                        }
                        <img src="@mainImg" class="w-100" style="height: 260px; object-fit: cover; filter: brightness(0.8);" alt="@car.Model?.Name">

                        <div class="p-4 d-flex flex-column" style="flex-grow: 1;">
                            <h3 class="h4 fw-bold mb-3">@car.Model?.Name</h3>

                            <div class="mb-4">
                                <span class="text-muted text-decoration-line-through fs-5 d-block mb-1">
                                    €@((car.Price + 15000).ToString("N0"))
                                </span>

                                <span class="fw-bold fs-3" style="color: #ff0000;">
                                    €@car.Price.ToString("N0")
                                </span>
                            </div>

                            <div class="mt-auto">
                                <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id"
                                   class="btn-blue d-block text-center fw-bold rounded-0 py-3">
                                    Inspect Car
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>
</div>